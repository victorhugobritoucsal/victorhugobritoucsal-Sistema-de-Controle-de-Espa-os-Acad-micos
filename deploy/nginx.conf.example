# Exemplo de publicacao do Front-End em producao (Nginx).
# O Nginx serve o build do Angular e e o UNICO caminho para o Back-End: ele injeta a chave
# X-Gateway-Key (que nunca chega ao navegador). O Back-End deve escutar apenas em 127.0.0.1.

server {
    listen 443 ssl;
    server_name espacos.exemplo.edu.br;

    ssl_certificate     /etc/ssl/certs/espacos.crt;
    ssl_certificate_key /etc/ssl/private/espacos.key;

    root /var/www/espacos/browser;   # conteudo de frontend/dist/frontend/browser
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Descarta qualquer valor enviado pelo cliente e injeta a chave do servidor
        proxy_set_header X-Gateway-Key "COLOQUE_AQUI_O_VALOR_DE_APP_GATEWAY_KEY";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
